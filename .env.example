# App session for the mobile UI
APP_USERNAME=agent
APP_PASSWORD=changeme
APP_USER_OWNER_MAP=agent:123
APP_USER_ZAMMAD_EMAIL_MAP=agent:agent@example.com
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_HOURS=720
SESSION_COOKIE_NAME=zammad_mobile_session
SESSION_COOKIE_SECURE=false
READ_ONLY_MODE=false

# Zammad connection.
# Point this to your Zammad instance.
ZAMMAD_URL=https://support.example.com
ZAMMAD_AUTH_MODE=token
ZAMMAD_TOKEN=replace-with-your-zammad-token
# Optional alternative to token mode:
# ZAMMAD_SESSION_COOKIE=_zammad_session=...

# Optional local fallback. When this file exists, the backend can import
# ZAMMAD_URL and ZAMMAD_TOKEN from a shared env file automatically.
ZAMMAD_FALLBACK_ENV_PATH=/path/to/shared-zammad.env

# PowerDNS presets and filters
POWERDNS_GROUP_ID=
POWERDNS_GROUP_IDS=10,11,12
POWERDNS_GROUP_NAME=Example Group
POWERDNS_ORGANIZATION_IDS=
POWERDNS_CUSTOMER_IDS=
POWERDNS_REQUIRE_ACCOUNT_FILTER=false
POWERDNS_DEFAULT_OWNER_ID=
POWERDNS_OWNER_OPTIONS=
# Used as a fallback if the backend cannot load active macros from /api/v1/macros.
POWERDNS_WORKFLOW_MACROS=waitingCustomer:2:Waiting for customer +7d,processing:18:Processing +7d,pendingAutoclose3:16:Pending autoclose +3d
UNASSIGNED_OWNER_IDS=1
NEW_TICKET_STATE_NAMES=new
OPEN_TICKET_STATE_NAMES=open
WAITING_CUSTOMER_STATE_NAMES=waiting for customer,pending reminder,pending action
PROCESSING_STATE_NAMES=processing
PENDING_AUTOCLOSE_STATE_NAMES=pending autoclose,pending auto-close,pending close
VISIBLE_TICKET_STATE_NAMES=new,open,waiting for customer,pending autoclose,pending auto-close,pending close,processing
HIGH_PRIORITY_NAMES=3 high,4 urgent
HIGH_PRIORITY_IDS=
OPEN_STATE_EXCLUSIONS=closed,merged,removed
TICKET_LIST_LIMIT=75

# Audit logging
AUDIT_LOG_PATH=logs/audit.log
NOTIFICATION_POLL_SECONDS=60
NOTIFICATION_STATE_PATH=logs/notification-state.json
PUSH_SUBSCRIPTIONS_PATH=logs/push-subscriptions.json

# Public URL used for push notification deep links.
# Examples:
# - direct LAN bind:  http://192.168.1.20:3001/zammad/
# - Tailscale Serve:  https://your-mac.tailnet.ts.net/zammad/
PUBLIC_APP_URL=https://example.com/zammad/
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# App bind and frontend build/runtime
HOST=0.0.0.0
PORT=3001
DOCKER_BIND_ADDRESS=127.0.0.1
HOST_PORT=3001
VITE_BASE_PATH=/zammad/
VITE_API_BASE=/zammad-api
VITE_AUTO_REFRESH_SECONDS=60
